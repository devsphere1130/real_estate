# --- Database (change ONLY this line to switch databases) ---
# XAMPP MySQL/MariaDB (default XAMPP: user root, empty password):
DATABASE_URL=mysql+pymysql://root:@localhost:3306/real_estate?charset=utf8mb4
# SQLite (zero setup):      sqlite:///./devsphere.db
# PostgreSQL (production):  postgresql+psycopg://user:password@host:5432/devsphere

# --- Auth ---
# Generate one:  py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS: comma separated frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# --- Rate limiting for POST /api/leads ---
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW_SECONDS=600

# Set true ONLY when the API runs behind a reverse proxy you control (uses X-Forwarded-For for rate limiting)
TRUST_PROXY_HEADERS=false

# Show the interactive API docs at /docs. Set false in production.
DOCS_ENABLED=true

# Public address of the website (used by scripts/generate_sitemap.py)
SITE_URL=http://localhost:5173

# Time zone used to decide which day an enquiry belongs to (dashboard charts)
TIMEZONE=Asia/Kolkata
